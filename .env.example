APP_NAME="Krishi Junction"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=krishi_junction
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@krishijunction.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Krishi Junction ---
KJ_OTP_LENGTH=6
KJ_OTP_TTL_MINUTES=10
KJ_OTP_MAX_ATTEMPTS=5
KJ_OTP_RATE_PER_HOUR=5
KJ_OTP_DEBUG_LOG=true

SMS_DRIVER=log
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KRISHI
MSG91_OTP_TEMPLATE_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
